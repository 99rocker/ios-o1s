diff --git a/iokit/Kernel/IOStartIOKit.cpp b/iokit/Kernel/IOStartIOKit.cpp
index d74c063..c4b88b1 100644
--- a/iokit/Kernel/IOStartIOKit.cpp
+++ b/iokit/Kernel/IOStartIOKit.cpp
@@ -177,9 +177,16 @@ ConfigureIOKit(void)
 	gRootNub->configureDefaults();
 }
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern "C" void sweet_beacon(unsigned slot, uint32_t argb);
+#endif
+
 void
 StartIOKitMatching(void)
 {
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_beacon(6, 0xffff00ffu);   /* magenta: IOKit service matching starting */
+#endif
 	SOCD_TRACE_XNU(START_IOKIT);
 	assert(gRootNub != NULL);
 	bool ok = gRootNub->startIOServiceMatching();
