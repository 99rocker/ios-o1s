+/*
+ * vili diagnostic: draw a 32-bit value as 32 on/off squares at a fixed screen
+ * row, through the console's framebuffer mapping (no disk, no locks). A set bit
+ * is bright, a clear bit dim; bit 31 is leftmost. Lets a single photo read an
+ * exact counter/address even while everything else is wedged. Remove later.
+ */
+void sweet_fbcon_u32(unsigned row, uint32_t val, uint32_t set_argb);
+void
+sweet_fbcon_u32(unsigned row, uint32_t val, uint32_t set_argb)
+{
+	if (fbcon_base == NULL || fbcon_width < 32 * 30) {
+		return;
+	}
+	const uint32_t sq = 24, gap = 6, cell = sq + gap;   /* 30px per bit */
+	uint32_t y0 = 40 + row * (sq + 12);
+	if (y0 + sq >= fbcon_height) {
+		return;
+	}
+	for (uint32_t b = 0; b < 32; b++) {
+		uint32_t on = (val >> (31 - b)) & 1;
+		uint32_t c = on ? set_argb : 0xff303030u;
+		uint32_t x0 = 20 + b * cell;
+		for (uint32_t y = 0; y < sq; y++) {
+			volatile uint32_t *line = fbcon_base + (y0 + y) * (fbcon_stride / 4);
+			for (uint32_t x = 0; x < sq; x++) {
+				line[x0 + x] = c;
+			}
+		}
+	}
+}
