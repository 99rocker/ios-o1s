diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index bb2a2bf..01cf7fe 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -473,6 +473,9 @@ bsd_rooted_ramdisk(void)
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+extern void sweet_beacon(unsigned slot, uint32_t argb);   /* vili boot beacons */
+#endif
 void
 bsd_init(void)
 {
@@ -498,6 +501,10 @@ bsd_init(void)
 #define bsd_init_kprintf(x, ...)
 #endif
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_beacon(8, 0xff80ff00u);   /* lime: bsd_init() entered */
+#endif
+
 	throttle_init();
 
 	printf(copyright);
@@ -691,6 +698,10 @@ bsd_init(void)
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	sweet_beacon(9, 0xff00ffc0u);   /* teal: vfsinit() done (past mid bsd_init) */
+#endif
+
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 	/* AMFI's MAC policy is built in on SWEET (bsd/kern/sweet_amfi.c). */
 	extern void sweet_amfi_policy_register(void);
@@ -872,6 +883,9 @@ bsd_init(void)
 	while (TRUE) {
 		int err;
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		sweet_beacon(10, 0xffff8000u);   /* orange: bsd_init reached setconf -> root mount */
+#endif
 		bsd_init_kprintf("calling setconf\n");
 		setconf();
 #if CONFIG_NETBOOT
