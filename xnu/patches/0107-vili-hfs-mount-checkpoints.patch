diff --git a/bsd/sweet_hfs/core/hfs_vfsops.c b/bsd/sweet_hfs/core/hfs_vfsops.c
index 557430b..b79f2d0 100644
--- a/bsd/sweet_hfs/core/hfs_vfsops.c
+++ b/bsd/sweet_hfs/core/hfs_vfsops.c
@@ -172,6 +172,11 @@ static int hfs_journal_replay(vnode_t devvp, vfs_context_t context);
  * mount system call
  */
 
+/* vili diag: draw a checkpoint value on-screen (row 3) to find where the root
+ * mount wedges before it ever reads a block. 1=hfs_mount 2=hfs_mountfs
+ * 3=about-to-read-VH 4=VH-read-returned. */
+extern void sweet_fbcon_u32(unsigned row, uint32_t val, uint32_t set_argb);
+
 int
 hfs_mount(struct mount *mp, vnode_t devvp, user_addr_t data, vfs_context_t context)
 {
@@ -190,6 +195,8 @@ hfs_mount(struct mount *mp, vnode_t devvp, user_addr_t data, vfs_context_t conte
 	int retval = E_NONE;
 	u_int32_t cmdflags;
 
+	sweet_fbcon_u32(3, 1, 0xff00ffffu);
+
 	if (data && (retval = copyin(data, (caddr_t)&args, sizeof(args)))) {
 		if (HFS_MOUNT_DEBUG) {
 			printf("hfs_mount: copyin returned %d for fs\n", retval);
@@ -1117,6 +1124,8 @@ hfs_mountfs(struct vnode *devvp, struct mount *mp, struct hfs_mount_args *args,
 	u_int32_t device_features = 0;
 	int isssd;
 
+	sweet_fbcon_u32(3, 2, 0xff00ffffu);
+
 	ronly = mp && vfs_isrdonly(mp);
 	dev = vnode_specrdev(devvp);
 	cred = p ? vfs_context_ucred(context) : NOCRED;
@@ -1256,14 +1265,18 @@ hfs_mountfs(struct vnode *devvp, struct mount *mp, struct hfs_mount_args *args,
 
 	mdb_offset = (daddr64_t)HFS_PRI_SECTOR(log_blksize);
 
-	if ((retval = (int)buf_meta_bread(devvp, 
-				HFS_PHYSBLK_ROUNDDOWN(mdb_offset, (phys_blksize/log_blksize)), 
+	sweet_fbcon_u32(3, 3, 0xff00ffffu);
+
+	if ((retval = (int)buf_meta_bread(devvp,
+				HFS_PHYSBLK_ROUNDDOWN(mdb_offset, (phys_blksize/log_blksize)),
 				phys_blksize, cred, &bp))) {
+		sweet_fbcon_u32(3, 5, 0xffff0000u);   /* 5 (red): VH read returned an error */
 		if (HFS_MOUNT_DEBUG) {
 			printf("hfs_mountfs: buf_meta_bread failed with %d\n", retval);
 		}
 		goto error_exit;
 	}
+	sweet_fbcon_u32(3, 4, 0xff00ff00u);   /* 4 (green): volume header read OK */
 	mdbp = hfs_malloc_data(kMDBSize);
 	bcopy((char *)buf_dataptr(bp) + HFS_PRI_OFFSET(phys_blksize), mdbp, kMDBSize);
 	buf_brelse(bp);
