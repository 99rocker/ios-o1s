 static void sweet_log_start(void);
+
+/*
+ * vili boot-progress beacon. Paints a solid full-width colored bar at a fixed
+ * screen position so a single still photo shows how far boot got, even when the
+ * wrapping fbcon text is unreadable. FB is the bootloader splash at 0xEA600000
+ * (AppleCLCD 1080x2400, stride 4320), mapped once via ml_io_map. The bars stack
+ * near the bottom of the panel; the highest-numbered bar present = how far we
+ * reached. Remove once vili boots to the GUI.
+ */
+static void
+sweet_beacon(unsigned slot, uint32_t argb)
+{
+	static volatile uint32_t *beacon_fb;
+	if (beacon_fb == NULL) {
+		beacon_fb = (volatile uint32_t *)ml_io_map(0xea600000UL, 0x2300000UL);
+	}
+	if (beacon_fb == NULL) {
+		return;
+	}
+	const unsigned stride = 4320u / 4u;     /* pixels per line */
+	const unsigned bar_h = 36u;
+	unsigned y0 = 2400u - (6u - slot) * 44u;
+	for (unsigned y = 0; y < bar_h; y++) {
+		volatile uint32_t *line = beacon_fb + (uint64_t)(y0 + y) * stride;
+		for (unsigned x = 0; x < 1080u; x++) {
+			line[x] = argb;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
 extern void sweet_sample_start(void);
 extern void sweet_keys_init(void);
 extern void sweet_touch_init(void);
