+/*
+ * vili boot-progress beacon: a solid full-width colored bar at a fixed y near
+ * the bottom of the panel, drawn through the console's own framebuffer mapping
+ * (fbcon_base). sweet_ufs.c's sweet_beacon() calls this instead of mapping the
+ * framebuffer a second time with ml_io_map -- that re-map paniced out of
+ * kmem_add_extra_claims. Eight slots (0..7); highest bar present = how far boot
+ * got. Remove once vili reaches the GUI.
+ */
+void sweet_fbcon_bar(unsigned slot, uint32_t argb);
+void
+sweet_fbcon_bar(unsigned slot, uint32_t argb)
+{
+	if (fbcon_base == NULL || slot > 7 || fbcon_height < 400) {
+		return;
+	}
+	uint32_t bar_h = 36;
+	uint32_t y0 = fbcon_height - (8 - slot) * 44;
+	if (y0 + bar_h > fbcon_height) {
+		return;
+	}
+	for (uint32_t y = 0; y < bar_h; y++) {
+		volatile uint32_t *line = fbcon_base + (y0 + y) * (fbcon_stride / 4);
+		for (uint32_t x = 0; x < fbcon_width; x++) {
+			line[x] = argb;
+		}
+	}
+}
