 			printf("SWEET UFS: command 0x%02x timed out\n", cdb[0]);
 			return ETIMEDOUT;
 		}
@@ -248,9 +276,14 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	}
 
 	uint32_t ocs = utrd->dw2 & 0xff;
+	if (su.exynos && ocs == 7 && (ucd->resp[6] || ucd->resp[7])) {
+		ocs = 0;                        /* UFSHCD_QUIRK_BROKEN_OCS_FATAL_ERROR */
+	}
 	if (ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
-		printf("SWEET UFS: command 0x%02x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x\n",
-		    cdb[0], ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7]);
+		const uint8_t *sd = &ucd->resp[34];     /* fixed-format sense data */
+		printf("SWEET UFS: command 0x%02x lun 0x%x failed: ocs 0x%x upiu 0x%x response 0x%x status 0x%x sense %x/%02x/%02x\n",
+		    cdb[0], su.lun, ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7],
+		    sd[2] & 0xf, sd[12], sd[13]);
 		return EIO;
 	}
 	return 0;
@@ -353,6 +386,28 @@ ufs_find_partition(const char *want)
 	return ENOENT;
 }
 
+/*
+ * Exynos: S-Boot leaves the UFS device in a low-power mode; every LU answers
+ * NOT READY until the device W-LUN gets START STOP UNIT (POWER CONDITION =
+ * Active), after a REQUEST SENSE that clears its unit attention.
+ */
+static int
+ufs_wake_device(void)
+{
+	static const uint8_t req_sense[6] = { 0x03, 0, 0, 0, 18, 0 };
+	static const uint8_t ssu_active[6] = { 0x1b, 0, 0, 0, 1u << 4, 0 };
+	uint8_t lun = su.lun;
+	int error = EIO;
+
+	su.lun = UFS_DEVICE_WLUN;
+	(void)ufs_scsi(req_sense, sizeof(req_sense), 18, false);
+	for (int i = 0; i < 3 && (error = ufs_scsi(ssu_active, sizeof(ssu_active), 0, false)); i++) {
+	}
+	su.lun = lun;
+	printf("SWEET UFS: device W-LUN START STOP UNIT (active): %d\n", error);
+	return error;
+}
+
 static int
 ufs_take_over_host(void)
 {
@@ -608,6 +663,15 @@ sweet_ufs_init(void)
 	su.wait = (wait == 1);
 
 	su.regs = ml_io_map(reg[0], reg[1]);
+	if (size >= 4 * sizeof(uintptr_t)) {
+		/*
+		 * Second reg pair: Exynos vendor HCI ("exynos-specific hci",
+		 * 0x13101100 on o1s, not page aligned): map its page, keep the offset.
+		 */
+		vm_offset_t vs_page = reg[2] & ~(vm_offset_t)PAGE_MASK;
+		su.vs = ml_io_map(vs_page, round_page(reg[2] + reg[3]) - vs_page) + (reg[2] - vs_page);
+		su.exynos = true;
+	}
 	if (kmem_alloc_contig(kernel_map, &su.dma, DMA_SIZE, PAGE_MASK, 0, 0,
 	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
 		printf("SWEET UFS: no contiguous DMA memory\n");
@@ -623,6 +687,9 @@ sweet_ufs_init(void)
 
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_take_over_host();
+	if (!error && su.exynos) {
+		error = ufs_wake_device();
+	}
 	if (!error) {
 		static const uint8_t tur[6] = { 0x00 };
 		/* The first command after the bootloader may report a unit attention. */
