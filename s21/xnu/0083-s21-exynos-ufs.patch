  * Writes are refused unless boot-arg ufsrw=1 is set. Every write is checked
  * against the partition bounds again right before it is issued, so nothing
  * outside the named partition can be written.
+ *
+ * Samsung Exynos 2100 (Galaxy S21, o1s): selected when /sweet-ufs has a
+ * second reg pair, the "exynos-specific hci" block. Quirks from Samsung's
+ * o1s kernel (ufs-exynos.c / ufshcd.c), each verified on the phone with the
+ * s21 shim probe (s21/shim/ufs.c):
+ *   - UFSHCD_QUIRK_PRDT_BYTE_GRAN: UTRD offsets/lengths in bytes
+ *   - PRDT_SET_SIZE(12): 4 KiB per PRD entry
+ *   - HCI_UTRL_NEXUS_TYPE (vendor +0x40): bit n = SCSI command in slot n
+ *   - UFSHCD_QUIRK_BROKEN_OCS_FATAL_ERROR: OCS 7 + response result = OCS ok
+ *   - UFSHCI_QUIRK_BROKEN_REQ_LIST_CLR: clear slot n by writing 1 << n
+ *   - S-Boot leaves the device asleep (sense 02/04/02 on every LU): wake it
+ *     with REQUEST SENSE + START STOP UNIT (Active) on the device W-LUN 0xD0,
+ *     as ufshcd_set_dev_pwr_mode() does.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -72,7 +85,10 @@ extern void sweet_usb_probe(void);
 #define UFS_BLOCK       4096u
 #define BOUNCE_SIZE     (1u << 20)
 #define PRDT_CHUNK      (256u << 10)            /* PRDT byte count field: 18 bits */
-#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK)
+#define PRDT_CHUNK_EXY  4096u                   /* Exynos: PRDT_SET_SIZE(12) */
+#define PRDT_MAX        (BOUNCE_SIZE / PRDT_CHUNK_EXY)
+#define VS_UTRL_NEXUS   0x40                    /* Exynos vendor HCI_UTRL_NEXUS_TYPE */
+#define UFS_DEVICE_WLUN 0xd0
 #define CMD_TIMEOUT_NS  (5ull * NSEC_PER_SEC)
 #define CMD_SPIN_NS     (50ull * NSEC_PER_USEC)
 #define CMD_SLEEP_NS    (200ull * NSEC_PER_USEC)
@@ -100,6 +116,8 @@ struct ucd {
 
 static struct {
 	vm_offset_t regs;
+	vm_offset_t vs;                         /* Exynos vendor HCI, 0 on Qualcomm */
+	bool exynos;
 	vm_offset_t dma;                        /* kernel VA of the DMA allocation */
 	uint64_t dma_pa;
 	uint8_t lun;
@@ -171,16 +189,18 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	utrd->dw2 = 0x0f;                       /* OCS invalid until updated */
 	utrd->ucdba = (uint32_t)ucd_pa;
 	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
-	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	/* Exynos: offsets and lengths in bytes (UFSHCD_QUIRK_PRDT_BYTE_GRAN). */
+	utrd->resp = su.exynos ? (512u << 16 | 512u) : ((512u / 4) << 16 | (512u / 4));
+	uint32_t n = 0;
 	if (len) {
-		uint32_t n = 0;
-		for (uint32_t done = 0; done < len; done += PRDT_CHUNK, n++) {
-			uint32_t chunk = MIN(PRDT_CHUNK, len - done);
+		uint32_t step = su.exynos ? PRDT_CHUNK_EXY : PRDT_CHUNK;
+		for (uint32_t done = 0; done < len; done += step, n++) {
+			uint32_t chunk = MIN(step, len - done);
 			ucd->prdt[n].addr_lo = (uint32_t)(bounce_pa + done);
 			ucd->prdt[n].addr_hi = (uint32_t)((bounce_pa + done) >> 32);
 			ucd->prdt[n].dbc = chunk - 1;
 		}
-		utrd->prdt = (1024u / 4) << 16 | n;
+		utrd->prdt = su.exynos ? (1024u << 16 | n * 16u) : ((1024u / 4) << 16 | n);
 	}
 
 	if (su.cache) {
@@ -189,7 +209,7 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
 		if (len) {
 			dma_clean(DMA_UCD + offsetof(struct ucd, prdt),
-			    (utrd->prdt & 0xffff) * sizeof(ucd->prdt[0]));
+			    n * sizeof(ucd->prdt[0]));
 		}
 	} else {
 		dma_sync(DMA_UTRL, sizeof(*utrd));
@@ -202,6 +222,13 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 			dma_sync(DMA_BOUNCE, len);
 		}
 	}
+	if (su.exynos) {
+		/* Slot 0 carries a SCSI command; keep the list running after errors. */
+		*(volatile uint32_t *)(su.vs + VS_UTRL_NEXUS) |= 1u;
+		if (!(ufs_rd(REG_UTRLRSR) & 1)) {
+			ufs_wr(REG_UTRLRSR, 1);
+		}
+	}
 	__builtin_arm_dsb(0xf);
 
 	ufs_wr(REG_UTRLDBR, 1);
@@ -219,7 +246,8 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
 	while (ufs_rd(REG_UTRLDBR) & 1) {
 		uint64_t now = mach_absolute_time();
 		if (now > deadline) {
-			ufs_wr(REG_UTRLCLR, ~1u);
